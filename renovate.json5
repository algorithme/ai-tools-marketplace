// managed-by: update-manager#8819591b648534aaadd494a7616d58db74bc395dcb2db7585caf2eb3e9efc8c0
// Generated by /renovate-sync from inventory.md and optional constraints.
// Regenerate with /renovate-sync; custom package rules belong in the region below.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // Matches this repository's configured Git identity.
  gitAuthor: 'olivier morel <algorithme@users.noreply.github.com>',
  extends: ['config:recommended'],
  enabledManagers: ['github-actions'],
  branchPrefix: 'deps/',
  dependencyDashboard: true,

  // Renovate waits for passing checks before merging on a subsequent run.
  platformAutomerge: false,

  vulnerabilityAlerts: {
    enabled: true,
    labels: ['security'],
  },

  packageRules: [
    {
      description: 'Automerge patch, digest, pin, and lockfile updates',
      matchUpdateTypes: ['patch', 'digest', 'pin', 'lockFileMaintenance'],
      automerge: true,
    },
    {
      description: 'Require dashboard approval for major bumps; handle with /update-manager',
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
      labels: ['needs-update-manager'],
    },
    {
      description: 'Open PRs for minor bumps without automerge',
      matchUpdateTypes: ['minor'],
      automerge: false,
    },
    {
      description: 'User opt-in (inventory.automerge_minor): automerge minor for github-actions',
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor'],
      automerge: true,
    },
    {
      description: 'Match update-manager commit conventions for GitHub Actions',
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['major', 'minor', 'patch', 'digest', 'pin', 'pinDigest', 'replacement', 'rollback', 'bump'],
      commitMessagePrefix: 'deps(github-actions):',
    },

    // region: user-managed
    // Add custom packageRules here. /renovate-sync preserves this block.
    // endregion: user-managed
  ],
}
