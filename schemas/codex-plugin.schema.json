{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Codex compatibility manifest",
  "description": "The shared-skills and command-hooks subset used by this marketplace, not the full Codex manifest specification.",
  "type": "object",
  "required": ["name", "version", "skills", "hooks"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+].+)?$" },
    "description": { "type": "string" },
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "homepage": { "type": "string", "format": "uri" },
    "repository": { "type": "string", "format": "uri" },
    "license": { "type": "string" },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "skills": { "type": "string", "pattern": "^\\./" },
    "hooks": { "type": "string", "pattern": "^\\./" }
  }
}
