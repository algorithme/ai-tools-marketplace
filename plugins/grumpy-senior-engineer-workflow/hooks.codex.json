{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${PLUGIN_ROOT}/hooks/load-context.sh\"", "timeout": 5 },
          { "type": "command", "command": "bash \"${PLUGIN_ROOT}/hooks/load-adr-pointer.sh\"", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${PLUGIN_ROOT}/hooks/codex-plan.py\"", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${PLUGIN_ROOT}/hooks/codex-plan.py\"", "timeout": 5 }
        ]
      }
    ]
  }
}
